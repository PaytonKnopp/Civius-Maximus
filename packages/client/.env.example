# Copy to .env.local to build or run the game with accounts, cloud saves and public games
# (docs/guides/supabase.md). Leave them empty for none.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Your own relay (TURN) for players behind strict networks, tried before PeerJS's free shared
# one (docs/guides/online.md). Comma-separated URLs, e.g. turn:a.relay.metered.ca:80,turns:...
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
