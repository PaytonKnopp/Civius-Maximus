{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Civius Maximus",
  "version": "0.1.0",
  "identifier": "com.paytonknopp.civiusmaximus",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @cx/client dev",
    "beforeBuildCommand": "pnpm --filter @cx/client build"
  },
  "app": {
    "windows": [
      {
        "title": "Civius Maximus",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "StrategyGame",
    "shortDescription": "A Civ-style 4X game to play with friends",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
